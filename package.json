{
  "name": "hub-test-package",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev-only harness for type-checking and testing the hub-test HubSpot app cards.",
  "scripts": {
    "typecheck": "tsc --noEmit -p src/app/cards/tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hubspot/ui-extensions": "0.15.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18",
    "typescript": "^5",
    "vitest": "^3"
  }
}
